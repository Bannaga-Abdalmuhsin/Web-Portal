{
  "expo": {
    "name": "ACES-MSD Fueling",
    "slug": "aces-technician-app",
    "owner": "advanced-communications-and-electronics-systems-company",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "technician-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1E3E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acessa.technician",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Used to photograph ODO meter and tank readings for mission documentation.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos of fuel tank and ODO meter readings.",
        "NSLocationWhenInUseUsageDescription": "Used to record the location of fuel delivery activities.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Used to record the location of fuel delivery activities.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.acessa.technician",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Used to record the location of fuel delivery activities."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0B1E3E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "860a0677-c225-4ed3-8e6b-f722b1be6a0d"
      }
    }
  }
}
